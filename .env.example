# Google Gemini API Key (Multimodal Live API requires Gemini 2.0 access)
GEMINI_API_KEY=your_gemini_api_key_here

# Backend Server Port
PORT=3000

# Gemini Model (Live API: gemini-2.5-flash-native-audio-latest)
GEMINI_MODEL=gemini-2.5-flash-native-audio-latest

# Voice Name: Aoede, Puck, Charon, Fenrir, Kore
VOICE_NAME=Puck
